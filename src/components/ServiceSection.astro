---
/**
 * One service block. Used three times, once per service.
 *
 * The media column is a carousel built from the service's gallery: CSS
 * scroll-snap carries the manual gestures, and one small hoisted script adds
 * arrows, dots and an autoplay that pauses on hover, on focus and when the
 * tab is hidden.
 *
 * `reversed` mirrors the layout so consecutive sections alternate the side
 * the media sits on, and `surface` alternates the background between the
 * page colour and the cream surface.
 */
import type { Locale } from "../i18n/translations";
import { t } from "../i18n/translations";

interface Props {
  locale: Locale;
  /** Anchor target, also used to build the heading id. */
  id: string;
  title: string;
  lead: string;
  body: string;
  /** Ordered image URLs; the first one leads the carousel. */
  gallery: string[];
  imageAlt?: string;
  index: number;
  reversed?: boolean;
  surface?: boolean;
}

const {
  locale,
  id,
  title,
  lead,
  body,
  gallery,
  imageAlt = "",
  index,
  reversed = false,
  surface = false,
} = Astro.props;

const strings = t(locale);
const headingId = `${id}-title`;
const indexLabel = String(index).padStart(2, "0");
---

<section
  id={id}
  class:list={["service page-section", { "service--surface": surface }]}
  aria-labelledby={headingId}
>
  <div class:list={["ss-container service-inner", { "service-inner--reversed": reversed }]}>
    <div class="service-content">
      <p class="section-kicker">
        <span class="service-index" aria-hidden="true">{indexLabel}</span>
        {strings.services_kicker}
      </p>
      <h2 id={headingId} class="section-title service-title">{title}</h2>
      <p class="service-lead">{lead}</p>
      <p class="section-copy">{body}</p>
    </div>

    <div class="service-media carousel" data-carousel>
      <div
        class="carousel-track"
        data-carousel-track
        tabindex="0"
        role="group"
        aria-roledescription="carousel"
        aria-label={title}
      >
        {
          gallery.map((src) => (
            <div class="carousel-slide">
              <img src={src} alt={imageAlt} loading="lazy" decoding="async" />
            </div>
          ))
        }
      </div>

      <div class="carousel-ui">
        <button type="button" class="carousel-btn" data-carousel-prev aria-label={`Previous ${title} image`}>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M15 5l-7 7 7 7"/></svg>
        </button>

        <div class="carousel-dots">
          {
            gallery.map((_, i) => (
              <button
                type="button"
                class:list={["carousel-dot", { "is-active": i === 0 }]}
                data-carousel-dot
                aria-label={`Go to ${title} image ${i + 1}`}
                aria-current={i === 0 ? "true" : undefined}
              />
            ))
          }
        </div>

        <button type="button" class="carousel-btn" data-carousel-next aria-label={`Next ${title} image`}>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 5l7 7-7 7"/></svg>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .service--surface {
    background: var(--surface);
  }

  .service-inner {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 4.5rem);
    width: 100%;
  }

  .service-inner--reversed .service-content {
    order: 2;
  }

  /* ----- carousel ------------------------------------------------------- */

  .carousel {
    position: relative;
  }

  .carousel-track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .carousel-track::-webkit-scrollbar {
    display: none;
  }

  .carousel-slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
    height: clamp(380px, 62vh, 620px);
  }

  .carousel-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .carousel-ui {
    position: absolute;
    right: clamp(0.75rem, 2vw, 1.5rem);
    bottom: clamp(0.75rem, 2vw, 1.5rem);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.375rem 0.625rem;
    background: color-mix(in srgb, var(--color-white-cream) 88%, transparent);
    backdrop-filter: blur(4px);
    border-radius: 999px;
  }

  .carousel-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    padding: 0;
    border: none;
    border-radius: 999px;
    background: transparent;
    color: var(--color-black);
    cursor: pointer;
    transition: background var(--duration-fast) var(--ease-out);
  }

  .carousel-btn:hover {
    background: color-mix(in srgb, var(--color-black) 8%, transparent);
  }

  .carousel-dots {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .carousel-dot {
    width: 7px;
    height: 7px;
    padding: 0;
    border: none;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-black) 25%, transparent);
    cursor: pointer;
    transition: background var(--duration-fast) var(--ease-out),
      width var(--duration-fast) var(--ease-out);
  }

  .carousel-dot.is-active {
    width: 20px;
    background: var(--color-orange);
  }

  @media (max-width: 900px) {
    .service-inner {
      grid-template-columns: 1fr;
      align-self: stretch;
      align-content: start;
      gap: 1.75rem;
    }

    /* Text first, images below: the section may grow past one viewport on a
       phone, which is fine. */
    .service-inner--reversed .service-content {
      order: 0;
    }

    .carousel-slide {
      height: clamp(300px, 48vh, 460px);
    }
  }
</style>

<script>
  // One hoisted module wires every carousel on the page.
  const AUTOPLAY_MS = 5000;

  function setupCarousel(root) {
    const track = root.querySelector("[data-carousel-track]");
    const prevBtn = root.querySelector("[data-carousel-prev]");
    const nextBtn = root.querySelector("[data-carousel-next]");
    const dots = Array.from(root.querySelectorAll("[data-carousel-dot]"));
    if (!track || !prevBtn || !nextBtn) return;

    const slides = Array.from(track.children);
    if (slides.length < 2) {
      root.querySelector(".carousel-ui")?.remove();
      return;
    }

    const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let paused = false;
    let timer = 0;

    const currentIndex = () =>
      Math.min(slides.length - 1, Math.max(0, Math.round(track.scrollLeft / track.clientWidth)));

    const goTo = (target, behavior) => {
      const clamped = (target + slides.length) % slides.length;
      track.scrollTo({
        left: clamped * track.clientWidth,
        behavior: behavior ?? (prefersReduced ? "auto" : "smooth"),
      });
    };

    const syncDots = () => {
      const active = currentIndex();
      dots.forEach((dot, i) => {
        dot.classList.toggle("is-active", i === active);
        if (i === active) dot.setAttribute("aria-current", "true");
        else dot.removeAttribute("aria-current");
      });
    };

    const restartAutoplay = () => {
      window.clearInterval(timer);
      if (prefersReduced || paused) return;
      timer = window.setInterval(() => goTo(currentIndex() + 1), AUTOPLAY_MS);
    };

    prevBtn.addEventListener("click", () => {
      goTo(currentIndex() - 1);
      restartAutoplay();
    });
    nextBtn.addEventListener("click", () => {
      goTo(currentIndex() + 1);
      restartAutoplay();
    });
    dots.forEach((dot, i) =>
      dot.addEventListener("click", () => {
        goTo(i);
        restartAutoplay();
      })
    );

    // Manual swipes move the dots too. A short debounce keeps it cheap.
    let scrollRaf = 0;
    track.addEventListener(
      "scroll",
      () => {
        window.cancelAnimationFrame(scrollRaf);
        scrollRaf = window.requestAnimationFrame(syncDots);
      },
      { passive: true }
    );

    // Autoplay pauses while the visitor is reading with a pointer or keyboard.
    root.addEventListener("pointerenter", () => { paused = true; restartAutoplay(); });
    root.addEventListener("pointerleave", () => { paused = false; restartAutoplay(); });
    root.addEventListener("focusin", () => { paused = true; restartAutoplay(); });
    root.addEventListener("focusout", () => { paused = false; restartAutoplay(); });

    document.addEventListener("visibilitychange", () => {
      paused = document.hidden;
      restartAutoplay();
    });

    restartAutoplay();
  }

  document.querySelectorAll("[data-carousel]").forEach(setupCarousel);
</script>
