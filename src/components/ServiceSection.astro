---
/**
 * One service block. Used three times, once per service.
 *
 * `reversed` mirrors the layout so consecutive sections alternate the side the
 * image sits on, and `surface` alternates the background between the page
 * colour and the cream surface.
 */
import type { Locale } from "../i18n/translations";
import { t } from "../i18n/translations";

interface Props {
  locale: Locale;
  /** Anchor target, also used to build the heading id. */
  id: string;
  title: string;
  lead: string;
  body: string;
  image: string;
  imageAlt?: string;
  index: number;
  reversed?: boolean;
  surface?: boolean;
}

const {
  locale,
  id,
  title,
  lead,
  body,
  image,
  imageAlt = "",
  index,
  reversed = false,
  surface = false,
} = Astro.props;

const strings = t(locale);
const headingId = `${id}-title`;
const indexLabel = String(index).padStart(2, "0");
---

<section
  id={id}
  class:list={["service page-section", { "service--surface": surface }]}
  aria-labelledby={headingId}
>
  <div class:list={["ss-container service-inner", { "service-inner--reversed": reversed }]}>
    <div class="service-content">
      <p class="section-kicker">
        <span class="service-index" aria-hidden="true">{indexLabel}</span>
        {strings.services_kicker}
      </p>
      <h2 id={headingId} class="section-title service-title">{title}</h2>
      <p class="service-lead">{lead}</p>
      <p class="section-copy">{body}</p>
    </div>

    <div class="service-media">
      <img src={image} alt={imageAlt} class="service-image" loading="lazy" decoding="async" />
    </div>
  </div>
</section>

<style>
  .service--surface {
    background: var(--surface);
  }

  .service-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: clamp(2rem, 5vw, 4.5rem);
  }

  .service-inner--reversed .service-content {
    order: 2;
  }

  .service-content {
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
  }

  .service-index {
    color: var(--accent);
    margin-right: 0.5rem;
  }

  .service-title {
    max-width: 12ch;
  }

  .service-lead {
    font-size: 1.25rem;
    line-height: 1.35em;
    color: var(--text-primary);
    max-width: 46ch;
  }

  .service-media {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: color-mix(in srgb, var(--color-grey) 15%, transparent);
  }

  .service-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .service-media:hover .service-image {
    transform: scale(1.03);
  }

  @media (max-width: 860px) {
    .service-inner {
      grid-template-columns: 1fr;
    }

    /* On one column the image always follows the text, so the reversal that
       alternates sides on desktop must not reorder anything here. */
    .service-inner--reversed .service-content {
      order: 0;
    }

    .service-media {
      aspect-ratio: 3 / 2;
    }
  }
</style>
