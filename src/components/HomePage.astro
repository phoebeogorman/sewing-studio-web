---
/**
 * The whole single page, composed from the content collection.
 *
 * The two route files under src/pages differ only in the locale they pass, so
 * the composition itself lives here instead of being copied into both. The
 * block list comes from src/content/home/<locale>.json: order, type and
 * variant of every section are content, not code.
 */
import { getEntry } from "astro:content";
import type { Locale } from "../i18n/translations";
import { localeHomePath, t } from "../i18n/translations";
import Layout from "../layouts/Layout.astro";
import Navbar from "./Navbar.astro";
import BlockRenderer from "./BlockRenderer.astro";
import Footer from "./Footer.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = t(locale);

const entry = await getEntry("home", locale);
if (!entry) {
  throw new Error(
    `Missing content entry "src/content/home/${locale}.json". Every locale needs one.`
  );
}

const { metaTitle, metaDescription, blocks } = entry.data;

// The "01", "02" counter runs across numbered blocks only, so inserting an
// unnumbered block between two services does not create a gap in the sequence.
let numberedCount = 0;
const rendered = blocks.map((block) => ({
  block,
  numberedIndex:
    "numbered" in block && block.numbered ? ++numberedCount : undefined,
}));

// The navbar follows the block list: a block opts in by giving itself a
// navLabel, so adding or reordering sections cannot leave the nav stale.
const navLinks = blocks.flatMap((block) =>
  "navLabel" in block && block.navLabel
    ? [{ href: `#${block.id}`, label: block.navLabel }]
    : []
);
---

<Layout
  locale={locale}
  canonicalPath={localeHomePath(locale)}
  title={metaTitle}
  description={metaDescription}
>
  <Navbar locale={locale} links={navLinks} />
  <main id="main-content">
    {
      rendered.map(({ block, numberedIndex }, i) => (
        <BlockRenderer
          block={block}
          locale={locale}
          isFirst={i === 0}
          numberedIndex={numberedIndex}
        />
      ))
    }
  </main>
  <Footer locale={locale} />
</Layout>

<dialog class="lightbox" data-lightbox aria-label={strings.lightbox_label}>
  {/* Photo navigation is revealed only when the source image belongs to a
      gallery with more than one image. */}
  <button
    type="button"
    class="lightbox-nav lightbox-nav--prev"
    data-lightbox-prev
    hidden
    aria-label={strings.lightbox_previous}
  >
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M15 5l-7 7 7 7"/></svg>
  </button>

  <div class="lightbox-frame" data-lightbox-frame>
    <img class="lightbox-img" alt="" src="" data-lightbox-img />
  </div>

  <button
    type="button"
    class="lightbox-nav lightbox-nav--next"
    data-lightbox-next
    hidden
    aria-label={strings.lightbox_next}
  >
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 5l7 7-7 7"/></svg>
  </button>

  <button
    type="button"
    class="lightbox-btn"
    data-lightbox-close
    aria-label={strings.lightbox_close}
  >
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 5l14 14M19 5L5 19"/></svg>
  </button>
</dialog>

<style>
  /* The viewer is a card lifted from the page, not a black cinema screen:
     the panel keeps the site surface and the backdrop is a soft neutral
     scrim so the page stays visible behind it. */
  .lightbox {
    position: fixed;
    inset: 0;
    margin: auto;
    width: min(1200px, 94vw);
    height: min(86dvh, 900px);
    max-width: none;
    max-height: none;
    padding: clamp(0.75rem, 2vw, 1.25rem);
    border: 1px solid var(--border-strong);
    background: var(--background);
    color: var(--text-primary);
    overflow: hidden;
    box-shadow: 0 28px 80px -28px
      color-mix(in srgb, var(--color-black) 45%, transparent);
  }

  .lightbox::backdrop {
    background: color-mix(in srgb, var(--color-black) 22%, transparent);
    backdrop-filter: blur(2px);
  }

  .lightbox-frame {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    overflow: hidden;
    touch-action: none;
  }

  .lightbox-img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    transform-origin: center;
    transition: transform var(--duration-base) var(--ease-out);
    user-select: none;
  }

  /* Photo navigation, centred on the left and right edges. Kept until the
     image comes from a gallery; `hidden` kicks in otherwise. */
  .lightbox-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--background) 82%, transparent);
    backdrop-filter: blur(4px);
    color: var(--text-primary);
    cursor: pointer;
    transition: border-color var(--duration-fast) var(--ease-out),
      background var(--duration-fast) var(--ease-out);
  }

  .lightbox-nav[hidden] {
    display: none;
  }

  .lightbox-nav:hover {
    border-color: var(--border-strong);
    background: var(--surface);
  }

  .lightbox-nav--prev {
    left: clamp(0.5rem, 1.5vw, 1rem);
  }

  .lightbox-nav--next {
    right: clamp(0.5rem, 1.5vw, 1rem);
  }

  .lightbox-btn {
    position: absolute;
    top: clamp(0.5rem, 1.5vw, 1rem);
    right: clamp(0.5rem, 1.5vw, 1rem);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--background) 82%, transparent);
    backdrop-filter: blur(4px);
    color: var(--text-primary);
    cursor: pointer;
    transition: border-color var(--duration-fast) var(--ease-out),
      background var(--duration-fast) var(--ease-out);
  }

  .lightbox-btn:hover {
    border-color: var(--border-strong);
    background: var(--surface);
  }
</style>

<script>
  // One hoisted module wires the whole page: mobile nav, image carousels and
  // the fullscreen lightbox. All selectors are opt-in data attributes, so the
  // script degrades to a no-op if a section is ever removed.

  // ----- mobile nav -------------------------------------------------------
  const nav = document.querySelector("[data-nav-menu]");
  const toggle = document.querySelector("[data-nav-toggle]");
  if (nav && toggle) {
    const closeMenu = () => {
      nav.removeAttribute("data-open");
      toggle.setAttribute("aria-expanded", "false");
      toggle.setAttribute("aria-label", toggle.dataset.openLabel ?? "");
    };
    const openMenu = () => {
      nav.setAttribute("data-open", "");
      toggle.setAttribute("aria-expanded", "true");
      toggle.setAttribute("aria-label", toggle.dataset.closeLabel ?? "");
    };
    toggle.addEventListener("click", () => {
      if (nav.hasAttribute("data-open")) closeMenu();
      else openMenu();
    });
    nav.addEventListener("click", (event) => {
      if (event.target.closest("a")) closeMenu();
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && nav.hasAttribute("data-open")) {
        closeMenu();
        toggle.focus();
      }
    });
    const desktop = window.matchMedia("(min-width: 861px)");
    desktop.addEventListener("change", (event) => {
      if (event.matches) closeMenu();
    });
  }

  // ----- carousels ---------------------------------------------------------
  const AUTOPLAY_MS = 5000;

  function setupCarousel(root) {
    const track = root.querySelector("[data-carousel-track]");
    const prevBtn = root.querySelector("[data-carousel-prev]");
    const nextBtn = root.querySelector("[data-carousel-next]");
    const dots = Array.from(root.querySelectorAll("[data-carousel-dot]"));
    if (!track || !prevBtn || !nextBtn) return;

    const slides = Array.from(track.children);
    if (slides.length < 2) {
      root.querySelector(".carousel-ui")?.remove();
      return;
    }

    const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let paused = false;
    let timer = 0;

    const currentIndex = () =>
      Math.min(slides.length - 1, Math.max(0, Math.round(track.scrollLeft / track.clientWidth)));

    const goTo = (target, behavior) => {
      const clamped = (target + slides.length) % slides.length;
      track.scrollTo({
        left: clamped * track.clientWidth,
        behavior: behavior ?? (prefersReduced ? "auto" : "smooth"),
      });
    };

    const syncDots = () => {
      const active = currentIndex();
      dots.forEach((dot, i) => {
        dot.classList.toggle("is-active", i === active);
        if (i === active) dot.setAttribute("aria-current", "true");
        else dot.removeAttribute("aria-current");
      });
    };

    const restartAutoplay = () => {
      window.clearInterval(timer);
      if (prefersReduced || paused) return;
      timer = window.setInterval(() => goTo(currentIndex() + 1), AUTOPLAY_MS);
    };

    prevBtn.addEventListener("click", () => {
      goTo(currentIndex() - 1);
      restartAutoplay();
    });
    nextBtn.addEventListener("click", () => {
      goTo(currentIndex() + 1);
      restartAutoplay();
    });
    dots.forEach((dot, i) =>
      dot.addEventListener("click", () => {
        goTo(i);
        restartAutoplay();
      })
    );

    let scrollRaf = 0;
    track.addEventListener(
      "scroll",
      () => {
        window.cancelAnimationFrame(scrollRaf);
        scrollRaf = window.requestAnimationFrame(syncDots);
      },
      { passive: true }
    );

    root.addEventListener("pointerenter", () => { paused = true; restartAutoplay(); });
    root.addEventListener("pointerleave", () => { paused = false; restartAutoplay(); });
    root.addEventListener("focusin", () => { paused = true; restartAutoplay(); });
    root.addEventListener("focusout", () => { paused = false; restartAutoplay(); });

    document.addEventListener("visibilitychange", () => {
      paused = document.hidden;
      restartAutoplay();
    });

    restartAutoplay();
  }

  document.querySelectorAll("[data-carousel]").forEach(setupCarousel);

  // ----- lightbox -----------------------------------------------------------
  const dialog = document.querySelector("[data-lightbox]");
  if (dialog) {
    const frame = dialog.querySelector("[data-lightbox-frame]");
    const img = dialog.querySelector("[data-lightbox-img]");
    const closeBtn = dialog.querySelector("[data-lightbox-close]");
    const prevBtn = dialog.querySelector("[data-lightbox-prev]");
    const nextBtn = dialog.querySelector("[data-lightbox-next]");
    let gallery = [];
    let index = 0;
    let zoom = 1;

    const clampZoom = (value) => Math.min(4, Math.max(1, value));

    const applyZoom = (value) => {
      zoom = clampZoom(value);
      img.style.transform = zoom === 1 ? "" : `scale(${zoom})`;
    };

    const setImage = () => {
      img.src = gallery[index].src;
      img.alt = gallery[index].alt || "";
      applyZoom(1);
    };

    const renderNav = () => {
      const multi = gallery.length > 1;
      prevBtn.hidden = !multi;
      nextBtn.hidden = !multi;
    };

    const goToIndex = (target) => {
      if (gallery.length < 2) return;
      index = (target + gallery.length) % gallery.length;
      setImage();
    };

    const openLightbox = (source) => {
      // A carousel source opens in gallery mode (arrows, swipe and arrow keys),
      // any other image opens alone.
      const carousel = source.closest("[data-carousel]");
      if (carousel) {
        gallery = Array.from(carousel.querySelectorAll("[data-carousel-track] img")).map(
          (i) => ({ src: i.currentSrc || i.src, alt: i.alt })
        );
      } else {
        gallery = [{ src: source.currentSrc || source.src, alt: source.alt || "" }];
      }
      const current = source.currentSrc || source.src;
      index = gallery.findIndex((entry) => entry.src === current);
      if (index < 0) index = 0;
      setImage();
      renderNav();
      if (dialog.open) dialog.close();
      dialog.showModal();
    };

    document.querySelectorAll("[data-lightbox-open]").forEach((el) => {
      el.addEventListener("click", () => {
        const source = el.tagName === "IMG" ? el : el.querySelector("img");
        if (source) openLightbox(source);
      });
    });

    closeBtn.addEventListener("click", () => dialog.close());
    prevBtn.addEventListener("click", () => goToIndex(index - 1));
    nextBtn.addEventListener("click", () => goToIndex(index + 1));

    // Wheel zooms in place; the page under the modal is inert, so the gesture
    // cannot scroll anything else.
    frame.addEventListener("wheel", (event) => {
      if (!dialog.open) return;
      event.preventDefault();
      const factor = event.deltaY < 0 ? 1.15 : 1 / 1.15;
      applyZoom(zoom * factor);
    });

    // Pointer gestures: pinch zooms on touch; a horizontal drag at zoom level 1
    // moves between photos.
    const pointers = new Map();
    let startDistance = 0;
    let startZoom = 1;
    let dragStartX = 0;
    let dragStartY = 0;
    let lastX = 0;
    let lastY = 0;

    frame.addEventListener("pointerdown", (event) => {
      if (!dialog.open) return;
      try {
        frame.setPointerCapture(event.pointerId);
      } catch {
        // The pointer may already be gone between events; capture is a nicety.
      }
      pointers.set(event.pointerId, { x: event.clientX, y: event.clientY });
      lastX = event.clientX;
      lastY = event.clientY;
      if (pointers.size === 1) {
        dragStartX = event.clientX;
        dragStartY = event.clientY;
      }
      if (pointers.size === 2) {
        const [a, b] = [...pointers.values()];
        startDistance = Math.hypot(a.x - b.x, a.y - b.y);
        startZoom = zoom;
      }
    });

    frame.addEventListener("pointermove", (event) => {
      if (!dialog.open || !pointers.has(event.pointerId)) return;
      pointers.set(event.pointerId, { x: event.clientX, y: event.clientY });
      lastX = event.clientX;
      lastY = event.clientY;
      if (pointers.size === 2) {
        const [a, b] = [...pointers.values()];
        const distance = Math.hypot(a.x - b.x, a.y - b.y);
        if (startDistance > 0) applyZoom(startZoom * (distance / startDistance));
      }
    });

    const endPointer = (event) => {
      if (!pointers.has(event.pointerId)) return;
      const wasPinch = pointers.size === 2;
      pointers.delete(event.pointerId);
      if (!wasPinch && pointers.size === 0 && zoom === 1) {
        const dx = lastX - dragStartX;
        const dy = lastY - dragStartY;
        if (Math.abs(dx) > 60 && Math.abs(dy) < 120) {
          goToIndex(index + (dx < 0 ? 1 : -1));
        }
      }
    };

    frame.addEventListener("pointerup", endPointer);
    frame.addEventListener("pointercancel", endPointer);

    document.addEventListener("keydown", (event) => {
      if (!dialog.open) return;
      if (event.key === "ArrowLeft") goToIndex(index - 1);
      if (event.key === "ArrowRight") goToIndex(index + 1);
    });

    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });

    dialog.addEventListener("close", () => applyZoom(1));
  }
</script>
