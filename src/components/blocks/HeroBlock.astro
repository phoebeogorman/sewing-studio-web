---
/**
 * Opening section, filling the first viewport.
 *
 * A full-bleed photograph sits behind the display type. The gradient keeps
 * the black type readable without hiding the image entirely.
 */
import type { Block } from "../../content.config";
import { contact } from "../../i18n/translations";
import { Image } from "astro:assets";
import { resolveContentImage } from "../../assets/images/index";

type HeroBlockData = Extract<Block, { type: "hero" }>;

interface Props {
  block: HeroBlockData;
  /** Only the first block on the page renders its title as the h1. */
  isFirst?: boolean;
}

const { block, isFirst = false } = Astro.props;
const TitleTag = isFirst ? "h1" : "h2";
const headingId = `${block.id}-title`;
const heroImg = resolveContentImage(block.image.src);
---

<section id={block.id} class="hero" aria-labelledby={headingId}>
  <Image
    src={heroImg}
    alt={block.image.alt}
    class="hero-photo"
    widths={[800, 1200, 1600, 2000]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <div class="hero-veil" aria-hidden="true"></div>

  <div class="ss-container hero-inner">
    <p class="section-kicker">{block.kicker}</p>
    <TitleTag id={headingId} class="display-title hero-title">{block.title}</TitleTag>
    <p class="hero-tagline">{block.tagline}</p>
    {block.intro.map((paragraph) => <p class="section-copy hero-intro">{paragraph}</p>)}

    <div class="hero-actions">
      <a href={`mailto:${contact.email}`} class="btn btn-primary">
        {block.ctaPrimaryLabel}
      </a>
      <a href={block.ctaSecondaryTarget} class="btn btn-outline">
        {block.ctaSecondaryLabel}
      </a>
    </div>
  </div>
</section>

<style>
  /* One full viewport under the sticky navbar: the scroll container already
     carries scroll-padding-top for anchors, so no extra offset here. */
  .hero {
    position: relative;
    min-height: calc(100svh - var(--navbar-height));
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-photo {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Cream wash fading towards the text side: enough contrast for black type
     while leaving the photograph visible on the right. Built with color-mix
     over the page token so no colour is hardcoded here. */
  .hero-veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      100deg,
      color-mix(in srgb, var(--color-white-cream) 94%, transparent) 0%,
      color-mix(in srgb, var(--color-white-cream) 82%, transparent) 42%,
      color-mix(in srgb, var(--color-white-cream) 35%, transparent) 100%
    );
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
    padding-block: clamp(48px, 8vw, 96px);
  }

  .hero-title {
    max-width: 14ch;
  }

  /* The recovered Wix line sits between title and intro as its own voice:
     display face, but smaller than the h1 and with generous tracking. */
  .hero-tagline {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.4vw, 1.75rem);
    font-weight: 400;
    line-height: 1.1em;
    letter-spacing: 0.04em;
    color: var(--color-orange);
  }

  .hero-intro {
    max-width: 52ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    margin-top: 0.5rem;
  }
</style>
