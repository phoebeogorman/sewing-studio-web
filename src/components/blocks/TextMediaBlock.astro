---
/**
 * Two columns: copy on one side, an image carousel on the other.
 *
 * The carousel is CSS scroll-snap for the manual gestures, plus one small
 * hoisted script that adds arrows, dots and an autoplay pausing on hover, on
 * focus and when the tab is hidden.
 *
 * `mediaSide` mirrors the layout so consecutive blocks can alternate the side
 * the media sits on, and `surface` alternates the background between the page
 * colour and the cream surface.
 */
import type { Block } from "../../content.config";
import type { Locale } from "../../i18n/translations";
import { contact, t } from "../../i18n/translations";
import { Image } from "astro:assets";
import { resolveContentImage } from "../../assets/images/index";

type TextMediaBlockData = Extract<Block, { type: "text-media" }>;

interface Props {
  block: TextMediaBlockData;
  locale: Locale;
  /** 1-based position among numbered blocks; drives the "01" counter. */
  index?: number;
}

const { block, locale, index } = Astro.props;
const strings = t(locale);
const headingId = `${block.id}-title`;
const indexLabel = index === undefined ? undefined : String(index).padStart(2, "0");

const labelPrev = strings.carousel_previous.replace("{title}", block.title);
const labelNext = strings.carousel_next.replace("{title}", block.title);

const slides = block.gallery.map((image) => ({
  meta: resolveContentImage(image.src),
  alt: image.alt,
}));
---

<section
  id={block.id}
  class:list={["service page-section", { "service--surface": block.surface === "cream" }]}
  aria-labelledby={headingId}
>
  <div
    class:list={[
      "ss-container service-inner",
      { "service-inner--reversed": block.mediaSide === "start" },
    ]}
  >
    <div class="service-content">
      <p class="section-kicker">
        {
          block.numbered && indexLabel && (
            <span class="service-index" aria-hidden="true">
              {indexLabel}
            </span>
          )
        }
        {block.kicker}
      </p>
      <h2 id={headingId} class="section-title service-title">{block.title}</h2>
      {block.lead && <p class="service-lead">{block.lead}</p>}
      {block.body.map((paragraph) => <p class="section-copy">{paragraph}</p>)}
      {block.price && <p class="service-price">{block.price}</p>}
      {block.priceCta && (
        <a class="service-price-cta" href={`mailto:${contact.email}`}>
          <span>{block.priceCta}</span>
          <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 12h16M13 5l7 7-7 7"/></svg>
        </a>
      )}
    </div>

    <div class="service-media carousel" data-carousel>
      <div
        class="carousel-track"
        data-carousel-track
        tabindex="0"
        role="group"
        aria-roledescription="carousel"
        aria-label={block.title}
      >
        {
          slides.map((slide) => (
            <button
              type="button"
              class="carousel-slide"
              data-lightbox-open
              aria-label={strings.lightbox_open.replace("{title}", block.title)}
            >
              <Image
                src={slide.meta}
                alt={slide.alt}
                widths={[480, 720, 960, 1200]}
                sizes="(max-width: 900px) 100vw, 50vw"
                loading="lazy"
              />
            </button>
          ))
        }
      </div>

      <div class="carousel-ui">
        <button
          type="button"
          class="carousel-btn"
          data-carousel-prev
          aria-label={labelPrev}
        >
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M15 5l-7 7 7 7"/></svg>
        </button>

        <div class="carousel-dots">
          {
            block.gallery.map((_, i) => (
              <button
                type="button"
                class:list={["carousel-dot", { "is-active": i === 0 }]}
                data-carousel-dot
                aria-label={strings.carousel_go_to
                  .replace("{title}", block.title)
                  .replace("{n}", String(i + 1))}
                aria-current={i === 0 ? "true" : undefined}
              />
            ))
          }
        </div>

        <button
          type="button"
          class="carousel-btn"
          data-carousel-next
          aria-label={labelNext}
        >
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 5l7 7-7 7"/></svg>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .service--surface {
    background: var(--surface);
  }

  .service-inner {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 4.5rem);
    width: 100%;
  }

  /* Same vertical rhythm as the text-image block, so the two read as one
     family when they alternate down the page. */
  .service-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .service-inner--reversed .service-content {
    order: 2;
  }

  .service-title {
    max-width: 18ch;
  }

  /* The bridge between the display title and the grey body copy: primary
     text colour and a step up in size, so it is not mistaken for the first
     line of the paragraph below it. */
  .service-lead {
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
    line-height: 1.3em;
    color: var(--text-primary);
    max-width: 46ch;
  }

  /* Closes the block with the same small-caps voice as the kicker, so the
     price reads as a label rather than as another line of body copy. */
  .service-price {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-primary);
    padding-top: 0.5rem;
    border-top: 1px solid var(--border);
  }

  /* Small mailto link under the price, for services quoted on application. */
  .service-price-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.75rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--accent);
    border-bottom: 1px solid transparent;
    padding-block: 0.125rem;
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .service-price-cta:hover {
    border-bottom-color: var(--accent);
  }

  /* Sits inside the kicker and inherits its casing and tracking; the accent
     colour and the gap are all it needs to read as a counter. */
  .service-index {
    margin-right: 0.75rem;
    color: var(--accent);
  }

  /* ----- carousel ------------------------------------------------------- */

  .carousel {
    position: relative;
  }

  .carousel-track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .carousel-track::-webkit-scrollbar {
    display: none;
  }

  .carousel-slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
    height: clamp(380px, 62vh, 620px);
    border: 0;
    padding: 0;
    font: inherit;
    color: inherit;
    background: none;
    cursor: zoom-in;
  }

  .carousel-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .carousel-ui {
    position: absolute;
    right: clamp(0.75rem, 2vw, 1.5rem);
    bottom: clamp(0.75rem, 2vw, 1.5rem);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.375rem 0.625rem;
    background: color-mix(in srgb, var(--color-white-cream) 88%, transparent);
    backdrop-filter: blur(4px);
    border-radius: 999px;
  }

  /* The arrows and dots stay hidden until the media is hovered or focused, so
     the photograph reads clean. On touch devices there is no hover, so they
     stay visible there. */
  @media (hover: hover) {
    .carousel-ui {
      opacity: 0;
      transform: translateY(6px);
      pointer-events: none;
      transition: opacity var(--duration-base) var(--ease-out),
        transform var(--duration-base) var(--ease-out);
    }

    .carousel:hover .carousel-ui,
    .carousel:focus-within .carousel-ui {
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }
  }

  .carousel-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    padding: 0;
    border: none;
    border-radius: 999px;
    background: transparent;
    color: var(--color-black);
    cursor: pointer;
    transition: background var(--duration-fast) var(--ease-out);
  }

  .carousel-btn:hover {
    background: color-mix(in srgb, var(--color-black) 8%, transparent);
  }

  .carousel-dots {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .carousel-dot {
    width: 7px;
    height: 7px;
    padding: 0;
    border: none;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-black) 25%, transparent);
    cursor: pointer;
    transition: background var(--duration-fast) var(--ease-out),
      width var(--duration-fast) var(--ease-out);
  }

  .carousel-dot.is-active {
    width: 20px;
    background: var(--color-orange);
  }

  @media (max-width: 900px) {
    .service-inner {
      grid-template-columns: 1fr;
      align-self: stretch;
      align-content: start;
      gap: 1.75rem;
    }

    /* Text first, images below: the section may grow past one viewport on a
       phone, which is fine. */
    .service-inner--reversed .service-content {
      order: 0;
    }

    .carousel-slide {
      height: clamp(300px, 48vh, 460px);
    }
  }
</style>
