---
/**
 * Sticky header: logo on the left, in-page section anchors on the right.
 *
 * The site is a single page, so every navigation link is an in-page anchor.
 * Scroll offsetting is handled by `scroll-padding-top` on the html element in
 * global.css, not here.
 */
import type { Locale } from "../i18n/translations";
import { alternateLocale, localeHomePath, t } from "../i18n/translations";

interface Props {
  locale: Locale;
  /** Derived from the block list, so the nav cannot drift from the page. */
  links: { href: string; label: string }[];
}

const { locale, links } = Astro.props;
const strings = t(locale);
const altLocale = alternateLocale(locale);

// The chosen language travels in the URL so that the locale script in the
// document head persists it, rather than immediately redirecting back.
const altHref = `${localeHomePath(altLocale)}?lang=${altLocale}`;
---

<header class="navbar">
  <div class="ss-container navbar-inner">
    <a href={localeHomePath(locale)} class="navbar-brand" aria-label={strings.nav_logo_alt}>
      {/* The horizontal lockup already contains the studio name, so it is not
          accompanied by a text label. The square icon is for favicons only:
          it leaves too much dead space in a header this short. */}
      <img
        src="/images/wordmark-the-sewing-studio.webp"
        srcset="/images/wordmark-the-sewing-studio.webp 1x, /images/wordmark-the-sewing-studio@2x.webp 2x"
        alt={strings.nav_logo_alt}
        width="170"
        height="48"
        class="navbar-logo"
      />
    </a>

    {/* Mobile-only toggle. The nav below becomes a dropdown panel under the
        header; the script in HomePage toggles data-open and the aria state. */}
    <button
      type="button"
      class="navbar-toggle"
      data-nav-toggle
      data-open-label={strings.nav_menu_open}
      data-close-label={strings.nav_menu_close}
      aria-label={strings.nav_menu_open}
      aria-expanded="false"
      aria-controls="navbar-menu"
    >
      <span class="navbar-toggle-bar" aria-hidden="true"></span>
      <span class="navbar-toggle-bar" aria-hidden="true"></span>
      <span class="navbar-toggle-bar" aria-hidden="true"></span>
    </button>

    <nav id="navbar-menu" class="navbar-nav" data-nav-menu aria-label={strings.nav_sections_label}>
      {
        links.length > 0 && (
          <ul class="navbar-list">
            {links.map((link) => (
              <li>
                <a href={link.href} class="navbar-link">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        )
      }

      <a href={altHref} class="navbar-lang" aria-label={strings.language_switch_label}>
        {strings.language_switch_text}
      </a>
    </nav>
  </div>
</header>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--background) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }

  .navbar-inner {
    min-height: var(--navbar-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .navbar-brand {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .navbar-logo {
    width: auto;
    height: 40px;
    object-fit: contain;
  }

  /* Three-line toggle, hidden on desktop. The open state is driven by the
     aria-expanded attribute the HomePage script keeps in sync. */
  .navbar-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 0 11px;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: transparent;
    cursor: pointer;
  }

  .navbar-toggle-bar {
    display: block;
    width: 100%;
    height: 2px;
    background: var(--text-primary);
    transition: transform var(--duration-fast) var(--ease-out),
      opacity var(--duration-fast) var(--ease-out);
  }

  .navbar-toggle[aria-expanded="true"] .navbar-toggle-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .navbar-toggle[aria-expanded="true"] .navbar-toggle-bar:nth-child(2) {
    opacity: 0;
  }

  .navbar-toggle[aria-expanded="true"] .navbar-toggle-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .navbar-nav {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.5rem);
  }

  .navbar-list {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .navbar-link {
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    padding-block: 0.5rem;
    border-bottom: 1px solid transparent;
    transition: color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .navbar-link:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .navbar-lang {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    transition: color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .navbar-lang:hover {
    color: var(--text-primary);
    border-color: var(--text-primary);
  }

  @media (max-width: 860px) {
    .navbar-toggle {
      display: flex;
    }

    /* The nav leaves the header row and becomes a dropdown panel. Hidden by
       default, revealed while the HomePage script holds data-open. */
    .navbar-nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 0 var(--container-pad) 1.25rem;
      background: color-mix(in srgb, var(--background) 96%, transparent);
      backdrop-filter: blur(8px);
      border-bottom: 1px solid var(--border);
      box-shadow: 0 18px 32px -24px
        color-mix(in srgb, var(--color-black) 45%, transparent);
    }

    .navbar-nav[data-open] {
      display: flex;
    }

    .navbar-list {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .navbar-list li {
      border-bottom: 1px solid var(--border);
    }

    .navbar-link {
      display: block;
      padding-block: 1rem;
      font-size: 1.0625rem;
    }

    .navbar-lang {
      align-self: flex-start;
      margin-top: 1.25rem;
    }
  }

  @media (max-width: 640px) {
    .navbar-logo {
      height: 30px;
    }
  }
</style>
