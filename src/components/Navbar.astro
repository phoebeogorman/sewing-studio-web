---
/**
 * Sticky header: logo on the left, the three service anchors on the right.
 *
 * The site is a single page, so every navigation link is an in-page anchor.
 * Scroll offsetting is handled by `scroll-padding-top` on the html element in
 * global.css, not here.
 */
import type { Locale } from "../i18n/translations";
import { alternateLocale, localeHomePath, t } from "../i18n/translations";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = t(locale);
const altLocale = alternateLocale(locale);

const links = [
  { href: "#alterations", label: strings.nav_alterations },
  { href: "#workshops", label: strings.nav_workshops },
  { href: "#bespoke", label: strings.nav_bespoke },
];

// The chosen language travels in the URL so that the locale script in the
// document head persists it, rather than immediately redirecting back.
const altHref = `${localeHomePath(altLocale)}?lang=${altLocale}`;
---

<header class="navbar">
  <div class="ss-container navbar-inner">
    <a href={localeHomePath(locale)} class="navbar-brand" aria-label={strings.nav_logo_alt}>
      {/* The horizontal lockup already contains the studio name, so it is not
          accompanied by a text label. The square icon is for favicons only:
          it leaves too much dead space in a header this short. */}
      <img
        src="/images/wordmark-the-sewing-studio.webp"
        srcset="/images/wordmark-the-sewing-studio.webp 1x, /images/wordmark-the-sewing-studio@2x.webp 2x"
        alt={strings.nav_logo_alt}
        width="170"
        height="48"
        class="navbar-logo"
      />
    </a>

    <nav class="navbar-nav" aria-label={strings.services_kicker}>
      <ul class="navbar-list">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="navbar-link">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <a href={altHref} class="navbar-lang" aria-label={strings.language_switch_label}>
        {strings.language_switch_text}
      </a>
    </nav>
  </div>
</header>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--background) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }

  .navbar-inner {
    min-height: var(--navbar-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .navbar-brand {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .navbar-logo {
    width: auto;
    height: 40px;
    object-fit: contain;
  }

  .navbar-nav {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.5rem);
  }

  .navbar-list {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .navbar-link {
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    padding-block: 0.5rem;
    border-bottom: 1px solid transparent;
    transition: color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .navbar-link:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .navbar-lang {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    transition: color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .navbar-lang:hover {
    color: var(--text-primary);
    border-color: var(--text-primary);
  }

  @media (max-width: 640px) {
    .navbar-list {
      gap: 0.875rem;
    }

    .navbar-link {
      font-size: 0.8125rem;
    }

    .navbar-logo {
      height: 30px;
    }
  }
</style>
